{
    "name": "microservice-monorepo/inventory-service",
    "type": "project",
    "description": "Inventory microservice - manages stock and reservations",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel-workflow/laravel-workflow": "^1.0",
        "spatie/laravel-model-states": "^2.7",
        "dedoc/scramble": "^0.12",
        "laravel-workflow/waterline": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
