# OpenClaw UI Developer Agent — Environment Variables
# Copy this file to .env and fill in the values.
#
# cp .env.example .env

OPENCLAW_GATEWAY_TOKEN=your-secure-gateway-token-here
OPENCLAW_HOOKS_TOKEN=your-secure-webhook-token

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

OPENCLAW_AUTH_PROFILE_ACCESS=
OPENCLAW_AUTH_PROFILE_REFRESH=
OPENCLAW_AUTH_PROFILE_EXPIRES=0
OPENCLAW_AUTH_PROFILE_ACCOUNT_ID=
