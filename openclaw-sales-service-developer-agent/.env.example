# OpenClaw Sales Service Developer Agent — Environment Variables
# Copy this file to .env and fill in the values.
#
# cp .env.example .env

# Auth tokens for OpenClaw gateway and hooks
OPENCLAW_GATEWAY_TOKEN=your-secure-gateway-token-here
OPENCLAW_HOOKS_TOKEN=your-secure-webhook-token

# Model access (pick the one you use)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Optional runtime-only Paperclip credential for workspace tooling
PAPERCLIP_API_KEY=

# Optional: seed OAuth profile into state/agents/main/agent/auth-profiles.json
OPENCLAW_AUTH_PROFILE_ACCESS=
OPENCLAW_AUTH_PROFILE_REFRESH=
OPENCLAW_AUTH_PROFILE_EXPIRES=0
OPENCLAW_AUTH_PROFILE_ACCOUNT_ID=
