# OpenClaw Sales Manager Agent — Environment Variables
# Copy this file to .env and fill in the values.
#
# cp .env.example .env

# ── Discord Bot Token ──────────────────────────────────────────────
# Required for the Discord channel.
# Create a bot at https://discord.com/developers/applications
# Enable: Server Members Intent, Message Content Intent
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# ── AI Model API Keys ─────────────────────────────────────────────
# Provide at least one. The primary model in openclaw.json is Claude;
# GPT-4o is the fallback.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ── Gateway Security ──────────────────────────────────────────────
# Required for a real gateway secret. OpenClaw uses OPENCLAW_GATEWAY_TOKEN
# before gateway.auth.token in config — leave token empty in openclaw.json.
# Never commit this file's real values; docker-compose loads .env at runtime only.
OPENCLAW_GATEWAY_TOKEN=your-secure-gateway-token-here

# ── Optional OpenAI Codex OAuth Profile Seed ───────────────────────
# If set, container startup writes:
#   $OPENCLAW_STATE_DIR/agents/main/agent/auth-profiles.json
OPENCLAW_AUTH_PROFILE_ACCESS=
OPENCLAW_AUTH_PROFILE_REFRESH=
OPENCLAW_AUTH_PROFILE_EXPIRES=0
OPENCLAW_AUTH_PROFILE_ACCOUNT_ID=

# ── Webhook Security ──────────────────────────────────────────────
# Token required in the Authorization header for /hooks/* endpoints.
# Must match the value in openclaw.json → hooks.token
OPENCLAW_HOOKS_TOKEN=your-secure-webhook-token
