load("@rules_pkg//:pkg.bzl", "pkg_tar")

pkg_tar(
    name = "invoice_service_tar",
    srcs = glob(["**/*"]),
    strip_prefix = ".",
)

filegroup(
    name = "invoice_service_files",
    srcs = glob(
        ["**/*"],
        exclude = [
            "vendor/**",
            "node_modules/**",
            ".env",
            "storage/logs/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

# Run invoice-service + its queue worker
# Usage: bazelisk run //invoice-service:run
sh_binary(
    name = "run",
    srcs = ["//scripts:run_service.sh"],
    args = [
        "invoice-service",
        "invoice-worker",
    ],
    data = [
        ":invoice_service_files",
        "//:docker-compose.yml",
    ],
)
